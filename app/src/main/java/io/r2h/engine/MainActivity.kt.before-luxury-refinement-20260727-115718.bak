    private fun runTtsProof() {
        val service = engineService ?: return setDiagnostics("TTS proof blocked: engine service is not connected.")
        val modelId = findTtsModelId(lastTruthSnapshot) ?: "piper-tts-ar-en"
        val english = "Hello, this is a local offline speech synthesis test from R2H Engine."
        val arabic = "مرحبا، هذا اختبار صوت محلي من محرك R2H."
        val combined = StringBuilder()
        setDiagnostics(
            "TTS proof started\n" +
                "Model: $modelId\n" +
                "API: IR2hEngineService.synthesizeSpeech(); inferModal(TEXT_TO_SPEECH)\n" +
                "Runtime: Sherpa-ONNX Piper\n" +
                "Network/cloud: not used by this app.",
        )
        runSingleTtsProof(
            service = service,
            modelId = modelId,
            label = "English",
            text = english,
            voice = "en",
            outputName = "tts-proof-en.wav",
            combined = combined,
        ) {
            runSingleTtsProof(
                service = service,
                modelId = modelId,
                label = "Arabic",
                text = arabic,
                voice = "ar",
                outputName = "tts-proof-ar.wav",
                combined = combined,
            ) { }
        }
    }

    private fun runSingleTtsProof(
        service: IR2hEngineService,
        modelId: String,
        label: String,
        text: String,
        voice: String,
        outputName: String,
        combined: StringBuilder,
        onComplete: () -> Unit,
    ) {
        val outputFile = File(filesDir, "proof-outputs/$outputName")
        val request = ModalInferenceRequest(
            requestId = "tts-proof-${voice}-${UUID.randomUUID()}",
            modelId = modelId,
            modality = "AUDIO",
            taskType = "TEXT_TO_SPEECH",
            inputRefs = emptyList(),
            textPrompt = text,
            params = mapOf(
                "tts.voice" to voice,
                "tts.outputPath" to outputFile.absolutePath,
                "engine.timeoutMs" to "300000",
            ),
        )
        try {
            service.synthesizeSpeech(request, object : IModalInferenceCallback.Stub() {
                override fun onResult(result: ModalInferenceResult) {
                    runOnUiThread {
                        combined.appendLine("$label TTS proof result")
                        combined.appendLine("requestId=${result.requestId}")
                        combined.appendLine("type=${result.resultType}")
                        combined.appendLine("finish=${result.finishReason}")
                        combined.appendLine(result.textValue.orEmpty())
                        combined.appendLine()
                        setDiagnostics(combined.toString().trimEnd())
                        onComplete()
                    }
                }

                override fun onError(error: EngineError) {
                    runOnUiThread {
                        combined.appendLine("$label TTS proof failed")
                        combined.append("${error.stage.name}/${error.code.name}: ${error.message}")
                        setDiagnostics(combined.toString())
                    }
                }
            })
        } catch (e: RemoteException) {
            setDiagnostics("TTS proof call failed: ${e.message ?: "RemoteException"}")
        }
    }

