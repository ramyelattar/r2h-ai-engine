private const val TAG = "MainActivity"
private const val MODELS_DIR = "models"

class MainActivity : AppCompatActivity() {

    private enum class ProductSection(val label: String, val subtitle: String) {
        CHAT("Chat", "Private on-device AI runtime."),
        STUDIO("Studio", "Local capability workspace."),
        AGENT("Agent", "On-device task execution."),
        SETTINGS("Settings", "Models, status, apps, and diagnostics."),
        MODELS("Models", "Catalog, repository, load state, and readiness."),
        STATUS("Status", "Readable runtime dashboard with technical details separated."),
        CONNECTED_APPS("Connected Apps", "Client integrations and live sessions."),
        AGENT_PERMISSIONS("Agent Permissions", "Permission Center for local tools and special access."),
        TOOL_AUDIT_LOG("Tool Audit Log", "Recent local tool calls, approvals, and raw details."),
        DIAGNOSTICS("Diagnostics", "Developer tools, model import, raw snapshot, and logs."),
    }

    private data class RuntimeUiState(
        val connected: Boolean = false,
        val apiVersion: Int? = null,
        val loadedModelId: String? = null,
        val truth: EngineTruthSnapshot? = null,
        val serviceModels: List<ModelInfo> = emptyList(),
        val localModels: List<ModelInfo> = emptyList(),
        val loadState: String? = null,
        val loadModelId: String? = null,
        val loadProgress: Int? = null,
        val loadError: String? = null,
        val errorMessage: String? = null,
    )

    private data class CapabilityUiRecord(
        val name: String,
        val status: String,
        val kind: StatusKind,
        val runtime: String,
        val model: String,
        val apiPath: String,
        val proofStatus: String,
        val reason: String,
    )

    private data class StudioCapability(
        val icon: String,
        val title: String,
        val description: String,
        val requirementChips: List<String>,
        val ready: Boolean,
        val actionLabel: String,
        val action: () -> Unit,
        val sampleLabel: String = "Run Sample",
        val sampleAction: () -> Unit = action,
    )

    private data class StudioDocumentRequest(
        val title: String,
        val destinationName: String,
        val onFileReady: (File) -> Unit,
    )

    private data class PendingApproval(
        val toolId: String,
        val title: String,
        val detail: String,
        val risk: ToolRiskLevel,
        val onApprove: () -> Unit,
    )

    private var engineService: IR2hEngineService? = null
    private val engineUiRefreshExecutor = EngineUiRefreshExecutor()
    private var isBound = false
    private var selectedModelId: String? = null
    private var isGenerating = false
    private var currentSection = ProductSection.CHAT
    private var lastTruthSnapshot: EngineTruthSnapshot? = null
    private var lastUiState = RuntimeUiState(errorMessage = "Starting engine service...")
    private var showTechnicalDetails = false
    private var lastPromptText = ""
    private var lastGenerationText = ""
    private var lastGenerationMeta = ""
    private var lastGenerationError: String? = null
    private var lastStudioWorkflowTitle = "Studio Workspace"
    private var lastStudioResultPreview = "Run a sample workflow to show a local result preview here."
    private var activeStudioWorkflowTitle: String? = null
    private var lastAgentTask = "Calculate 17 * 23 and explain the result."
    private var lastAgentTimeline = listOf("Ready for a local task.")
    private var lastAgentToolSummary = "Calculator, engine status inspector, and text planner are available."
    private var lastAgentResult = "Run a local task to show the final result in this workspace."
    private var lastAgentError: String? = null
    private var lastAgentMissingPermission: AgentPermissionItem? = null
    private var pendingApproval: PendingApproval? = null
    private var torchEnabled = false
    private var isAgentRunning = false
    private var pendingRuntimePermission: AgentPermissionItem? = null
    private var pendingStudioDocumentRequest: StudioDocumentRequest? = null
    private lateinit var localModelFolderManager: LocalModelFolderManager
    private var localModelScanResult: LocalModelScanResult = LocalModelScanResult.NoFolderSelected
    private var localModelManagerBusy = false
